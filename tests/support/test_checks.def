# tests/support/test_checks.def
#
# The test-only check registry (02-03-PLAN.md Task 1, D-11): same TOML
# syntax as src/core/checks.def, generated by the same tools/gen_registry.py
# with `--symbol-prefix test_` into a second, independent registry
# (TestCheckId / test_registry()) that never enters libmediadiff or the
# shipped mediadiff binary -- only tests/unit and tests/integration link it.
#
# Namespaced under the `t` group so no synthetic id can be mistaken for a
# real, shipped check (an acceptance criterion greps the binary for `t.` and
# requires zero matches). One check per comparison semantic (D-15: the unit
# is the semantic crossed with each status it can emit), plus three checks
# exercising flags/resolution rather than a new semantic:
#   t.volatile_tag        volatile = true
#   t.requires_pass_gate  requires_pass = true
#   t.aliased_new         carries an alias (t.aliased_old) and a
#                          [check.profile_severity] override, so
#                          CheckRegistry::resolve_alias and
#                          CheckDef::severity_for are both exercised against
#                          a real generated registry, not only production's.
#
# Severity is deliberately spread across info/warn/fail so severity
# resolution (D-04) has something to move; see 02-03-PLAN.md Task 2's
# fail-first coverage gate for which (semantic, status) cells these checks
# back with real fixtures under tests/fixtures/snapshots/.

[[check]]
id = "t.exact_string"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

[check.profile_severity]
# Demonstrates a real profile-severity exception against the test registry,
# mirroring src/core/checks.def's meta.tool_version override (02-02-PLAN.md).
strict_bitexact = "fail"

[[check]]
id = "t.tol_ms"
group = "t"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
# Two-threshold form (02-04-PLAN.md Task 1's grammar extension): a delta
# inside 3ms is pass, between 3ms and 5ms is warn, beyond 5ms is fail --
# the zone decides the status, independent of `severity` above (doc 01
# section 3). Backs the fail-first coverage gate's tol pass/warn/fail
# cells; t.tol_info (below) backs the info cell, which the two-threshold
# form cannot produce on its own.
tolerance = "3ms,5ms"

[[check]]
id = "t.tol_info"
group = "t"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "info"
tolerance = "5ms"

[[check]]
id = "t.set_tags"
group = "t"
semantic = "set"
unit = "none"
value_kind = "string_set"
severity = "fail"

[[check]]
id = "t.presence_track"
group = "t"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "fail"

[[check]]
id = "t.hash_chain"
group = "t"
semantic = "hash"
unit = "none"
value_kind = "hash_chain"
severity = "fail"

[[check]]
id = "t.dist_bins"
group = "t"
semantic = "dist"
unit = "percent"
value_kind = "histogram"
severity = "warn"
tolerance = "5%"

[[check]]
id = "t.dist_bins_fail"
group = "t"
semantic = "dist"
unit = "percent"
value_kind = "histogram"
severity = "fail"
tolerance = "5%"

[[check]]
id = "t.span_runs"
group = "t"
semantic = "span"
unit = "ms"
value_kind = "span_list"
# fail (not info): an introduced span escalates via this severity, and a
# removed-span-only case is always info regardless of severity (doc 01
# section 3) -- one check now backs all three of pass/info/fail.
severity = "fail"

[[check]]
id = "t.volatile_tag"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "info"
volatile = true

[[check]]
id = "t.requires_pass_gate"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"
requires_pass = true

[[check]]
id = "t.int64_count"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "int64"
severity = "fail"

[[check]]
# Added 02-07-PLAN.md Task 1: no other check (production or test-only) ever
# declared value_kind = "real" before this plan, which left Value's `double`
# alternative structurally untestable through read_snapshot/write_snapshot
# (both dispatch on a CheckDef's declared value_kind) even though this
# plan's own must_haves require exactly that coverage. Rule 2 addition
# (missing test infrastructure the plan's own acceptance criteria depend
# on), not a shipped-check addition.
id = "t.real_ratio"
group = "t"
semantic = "tol"
unit = "percent"
value_kind = "real"
severity = "warn"
tolerance = "5%"

[[check]]
id = "t.aliased_new"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"
aliases = ["t.aliased_old"]

[[check]]
id = "t.transform_resolution"
group = "t"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"
# 02-05-PLAN.md Task 3: the one check in either registry that carries
# transform_affected -- no shipped check does yet (the real resolution
# identity check lands in Phase 4). Values are "WIDTHxHEIGHT" strings;
# compare/exact.cpp's transform-profile path parses them, never the
# ordinary baseline-equality path when this flag and the `transform`
# profile are both active.
transform_affected = true
