# src/core/checks.def
#
# TOML-syntax despite the .def extension (D-01) — doc 01 section 2 mandates
# the filename `checks.def`; the content is TOML 1.0, parsed by
# tools/gen_registry.py with the Python 3.11+ standard-library `tomllib`
# module (D-05), never a third-party TOML library. Every entry is a
# `[[check]]` array-of-tables record.
#
# Keys:
#   id            dotted lowercase grammar [a-z0-9_]+(\.[a-z0-9_]+)*
#   group         the check's family, e.g. "meta"
#   semantic      exact | tol | set | presence | hash | dist | span
#   unit          none | ms | ms_per_min | frames | percent | db | lu |
#                 samples | ticks | count
#   value_kind    int64 | rational | real | string | string_set |
#                 histogram | span_list | hash_chain
#   severity      ignore | info | warn | fail        (baseline, D-04)
#   tolerance     optional; baseline tolerance grammar text, unparsed
#   volatile      optional bool, default false
#   requires_pass optional bool, default false
#   transform_affected  optional bool, default false -- true only for a
#                 check the `transform` profile's declared expectation
#                 converts into a comparison against that expectation
#                 rather than baseline equality (doc 01 section 5, ENG-10).
#                 The key exists as of 02-05-PLAN.md; `video.resolution`
#                 (04-06-PLAN.md, below) is the first shipped check to
#                 declare it. Also proven against a test-only check in
#                 tests/support/test_checks.def.
#   aliases       optional array of deprecated-alias id strings that now
#                 resolve to this check (doc 01 section 2)
#   flagged_values  array of strings; REQUIRED and non-empty when
#                 semantic = "state" (04-12-PLAN.md, D-10) -- the closed set
#                 of compared-value spellings that make the `state`
#                 comparator report a Finding (baseline OR candidate value
#                 in this set) rather than pass. REJECTED (a validation
#                 error) on any other semantic -- `video.hdr.coherence` is
#                 the first and, as of this phase, only check to declare it.
#
# Per-profile exceptions are declared as sub-tables on the check's own
# `[[check]]` array element — standard TOML array-of-tables-with-subtable
# syntax, not a special case tools/gen_registry.py invents:
#   [check.profile_severity]    profile name -> severity override
#   [check.profile_tolerance]   profile name -> tolerance override
# A profile with no entry inherits the baseline (D-04). Profile names must
# match core/registry.h's ProfileId enumerators exactly: strict_bitexact,
# sw_encoder, hw_encoder, remux, transform.
#
# Registered here: the seed set approved in Task 1 of 02-01-PLAN.md's
# checkpoint, now fully registered per 02-02-PLAN.md Task 1 — every check
# has a real, non-empty docs/checks/<id>.md (D-02). meta.tool_version also
# carries a demonstrative alias and profile-severity override so
# test_registry.cpp can exercise both against the real generated registry,
# not only against Task 3's fixture trees.

[[check]]
id = "meta.tool_version"
group = "meta"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"
# Demonstrative pre-v1 rename: "meta.version" was this check's id before it
# was renamed to the more specific "meta.tool_version". Renames without an
# alias are forbidden post-v1 (doc 01 section 2); this alias is what proves
# CheckRegistry::resolve_alias actually resolves a real declared alias
# rather than only the registry's synthetic unit-test fixtures.
aliases = ["meta.version"]

[check.profile_severity]
# Under strict-bitexact, a tool-version skew between baseline and candidate
# is escalated from a warning to a hard failure — that profile exists
# precisely to catch exactly this class of "the tool changed, not just the
# media" ambiguity.
strict_bitexact = "fail"

[[check]]
id = "meta.missing_candidate"
group = "meta"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "fail"

[[check]]
id = "meta.extra_candidate"
group = "meta"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "warn"

# Phase 3's tracer check (03-02-PLAN.md, 03-CHECK-ROSTER.md): the
# container family's own name, extracted from AVInputFormat.name's first
# comma-delimited token (doc 02 section 2) by src/analyzers/container/
# topology.cpp. A baseline/candidate container mismatch (e.g. "mov" vs
# "matroska") is almost always intentional and blocking -- hence `fail`,
# not `warn`.
[[check]]
id = "container.format"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 03-04-PLAN.md Task 1, 03-CHECK-ROSTER.md: the remaining four
# container-agnostic topology checks doc 02 section 2's table declares,
# expanding src/analyzers/container/topology.cpp beyond the tracer's single
# container.format measurement.

# Five-bin per-type stream Histogram (video/audio/subtitle/data/attachment,
# a zero-count bin always present) -- fixed bin order is what makes a
# dropped subtitle track a VALUE difference under `exact`, not a shape
# difference, and what keeps two consecutive runs' --json byte-identical.
[[check]]
id = "container.track_count"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "histogram"
severity = "fail"

# The ordered multiset of stream media types as one canonical comma-joined
# string, preserving both order and duplicates -- two files with the same
# types in a different order compare as a VALUE difference here (doc 02:
# "timecode and caption data tracks named in the message -- their loss is
# the headline", CONT-09).
[[check]]
id = "container.track_types"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# The ordered (media_type, codec_name) signature string in stream index
# order -- a reorder with identical membership fails THIS check while
# track_count/track_types (order-insensitive counts/multisets) still pass
# (doc 02: "a move, not add+remove"). `warn`, not `fail`: doc 02's own
# severity for this row.
[[check]]
id = "container.track_order"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

# A StringSet of canonicalized chapter entries (start/end ticks, shared
# timebase, title). `set` semantic: doc 02's own choice, since chapter
# reordering with identical membership is not itself meaningful the way
# stream order is. Auto-skips as `skipped:not_applicable_container` on
# MPEG-TS (03-04-PLAN.md Task 1's own must_have) -- `info` severity per doc
# 02's table.
[[check]]
id = "container.chapters"
group = "container"
semantic = "set"
unit = "none"
value_kind = "string_set"
severity = "info"

# 03-04-PLAN.md Tasks 2-3 (CONT-03, CONT-04), src/analyzers/container/meta.cpp.

# Container- and per-stream metadata dictionaries compared as a StringSet
# of "key=value" entries, with the four built-in volatile keys
# (creation_time, encoder, handler_name, encoding_tool) excluded from the
# compared value but retained in evidence (CONT-03) -- doc 02 section 2's
# own row.
[[check]]
id = "meta.tags"
group = "meta"
semantic = "set"
unit = "none"
value_kind = "string_set"
severity = "warn"

# Per-stream `language` tag, normalized so an absent tag and the literal
# `und` compare equal (CONT-04: a muxer artifact, not a regression) --
# normalization happens at measurement construction (meta.cpp), never in
# the `exact` comparator, so a stored snapshot already carries the
# normalized form.
[[check]]
id = "meta.tags.language"
group = "meta"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

# 03-05-PLAN.md Tasks 1-2 (PROBE-04, CONT-05), src/analyzers/container/
# mp4.cpp, src/probe/bmff_scan.{h,cpp}. Every one of the six ids below
# auto-skips as `skipped:not_applicable_container` on a non-MP4 container
# (src/analyzers/container/mp4.cpp's own family-agnostic sibling analyzer),
# and as `skipped:unparsed_mechanism` (carrying `stop_offset` in evidence)
# when the bmff_scan walk itself did not complete (03-CHECK-ROSTER.md).

# `moov` offset vs the first `mdat` offset, from the SAME bmff_scan
# top-level walk -- moov-before-mdat vs moov-after-mdat. Auto-skips (also
# as not_applicable_container) on a fragmented file, per doc 02 section 3's
# own note that init-segment layout governs instead there.
[[check]]
id = "container.mp4.faststart"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# ftyp's major brand plus every compatible brand, as one StringSet --
# evidence separately names major_brand/minor_version so a major-brand
# change is distinguishable from compatible-set churn.
[[check]]
id = "container.mp4.brands"
group = "container"
semantic = "set"
unit = "none"
value_kind = "string_set"
severity = "warn"

# progressive vs fragmented mode, derived from bmff_scan's own moof_count
# -- 03-CHECK-ROSTER.md's own deliberate split of doc 02's single
# `fragmentation` row: this half keeps the exact/fail mode signal.
[[check]]
id = "container.mp4.fragmentation"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# Split counterpart above -- the MEDIAN fragment duration (a RationalValue)
# at a ±20% tolerance, warn severity. Emits nothing (skips as
# not_applicable_container) on a progressive file.
[[check]]
id = "container.mp4.fragment_duration"
group = "container"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "warn"
tolerance = "20%"

# One measurement per track, at that track's own scope: the canonical
# string of that track's elst entries verbatim. `[check.profile_severity]`
# below matches doc 02 section 3's own "fail in remux/strict, warn in
# encoders" note (03-CHECK-ROSTER.md).
[[check]]
id = "container.mp4.edit_list"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

[check.profile_severity]
strict_bitexact = "fail"
remux = "fail"

[[check]]
id = "container.mp4.timescale"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "int64"
severity = "warn"

# 03-06-PLAN.md Task 2 (CONT-06, doc 02 section 4): the four container.mkv.*
# checks, emitted from ebml_scan (src/probe/ebml_scan.h). Auto-skip as
# not_applicable_container on a non-MKV input (mirrors container.mp4.*'s own
# two-AnalyzerSpec split), and as unparsed_mechanism when the ebml_scan walk
# itself did not complete (03-CHECK-ROSTER.md).

# Cues' own byte offset compared against the first Cluster's -- a SEEKING
# property, deliberately NOT named faststart (see
# docs/checks/container.mkv.cues_placement.md for why).
[[check]]
id = "container.mkv.cues_placement"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

# One measurement per track, at that track's own scope: CodecDelay
# converted from nanoseconds to SAMPLES via the track's own sampling
# frequency (checked_mul then checked_div, never a floating divide).
# Baseline severity `fail` per 03-CHECK-ROSTER.md's own note: per-codec
# severity is not representable (a CheckDef carries one severity), and for
# a non-Opus track CodecDelay is normally absent/zero on both sides, so the
# check simply never fires there -- a difference anywhere is itself
# suspicious enough to warrant `fail`.
[[check]]
id = "container.mkv.codec_delay"
group = "container"
semantic = "tol"
unit = "samples"
value_kind = "int64"
severity = "fail"
tolerance = "1samples"

# Info's own TimestampScale, at global scope. Matroska's own default is
# 1,000,000 ns (1 ms); evidence records that default so a reader can tell a
# departure-from-default apart from a change between two non-defaults.
[[check]]
id = "container.mkv.timestamp_scale"
group = "container"
semantic = "exact"
unit = "none"
value_kind = "int64"
severity = "warn"

# The `presence` semantic (doc 01 section 3): whether Info carries a
# Duration element at all -- a missing Duration means a live or
# unfinalized mux, which flips consumer expectations for the file.
[[check]]
id = "container.mkv.duration_element"
group = "container"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "info"

# 03-08-PLAN.md Tasks 1-3 (CONT-07, CONT-08, doc 02 section 5), src/analyzers/
# container/ts.cpp, src/probe/ts_scan.{h,cpp}. Every one of the six ids below
# auto-skips as `skipped:not_applicable_container` on a non-TS container
# (src/analyzers/container/ts.cpp's own family-agnostic sibling analyzer),
# and as `skipped:unparsed_mechanism` (carrying `stop_offset` in evidence)
# when the ts_scan walk itself did not complete (03-CHECK-ROSTER.md).

# The unflagged (non discontinuity_indicator) continuity-counter error
# count, summed across every PID at global scope -- `exact 0` gating: any
# nonzero count is a failure independent of the other side (doc 02 section
# 5). Evidence carries the per-PID breakdown and the first offending PID's
# byte offset.
[[check]]
id = "container.ts.cc_errors"
group = "container"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "fail"

# Split from doc 02's `cc_errors` row (03-CHECK-ROSTER.md): the FLAGGED
# (discontinuity_indicator) reset count, reported separately at `info` --
# the muxer declared it did that on purpose, so this is never folded into
# the gating cc_errors count above. Addition beyond doc 02's literal row
# count.
[[check]]
id = "container.ts.cc_discontinuities"
group = "container"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "info"

# The MAXIMUM spacing between consecutive PCRs on a program's own PCR_PID,
# in milliseconds, derived from ts_scan's mux-rate estimate (D-03: this
# value's `Measurement::estimated` flag widens the effective tolerance 3x
# at comparison, src/compare/tol.cpp). Program-scoped: Scope{Kind::program,
# index} where `index` is the PSI program_number (AVProgram::program_num),
# NEVER the AVFormatContext::programs[] array position (CONT-08). Skips as
# `insufficient_data` on fewer than two PCRs, never a fabricated interval.
[[check]]
id = "container.ts.pcr_interval"
group = "container"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
tolerance = "100ms"

# The MAXIMUM of the PAT and PMT section repetition intervals, in
# milliseconds, also `estimated` (D-03 widening applies, see pcr_interval
# above). Program-scoped, same program_number rule as pcr_interval --
# version churn breaks downstream remuxers, hence `warn`.
[[check]]
id = "container.ts.psi_interval"
group = "container"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "warn"
tolerance = "500ms"

# Split from doc 02's `psi_interval` row (03-CHECK-ROSTER.md): the PMT
# `version_number` CHANGE count -- a second semantic on the same id is not
# representable, hence its own id. Directly counted, NEVER `estimated`
# (widening a directly-counted value would silently loosen a real gate).
# Program-scoped, same program_number rule. Addition beyond doc 02's
# literal row count.
[[check]]
id = "container.ts.pmt_version_churn"
group = "container"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "warn"

# null_packets / total_packets, kept as an EXACT RationalValue (never
# pre-divided into a rounded percentage) -- a CBR mux efficiency drift tell
# (doc 02 section 5), `info` severity. Global scope: a whole-transport-
# stream property, not per-program (scoping it per program would
# double-count shared PIDs).
[[check]]
id = "container.ts.null_ratio"
group = "container"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "info"
tolerance = "5%"

# 03-09-PLAN.md (SIZE-01, PROBE-10's first size.* consumer), src/analyzers/
# size/size.cpp. Rate economics derived directly from PacketScan's own
# shared per-stream packet array (03-03-PLAN.md), plus the container's own
# on-disk byte size. D-02: size.stream_bitrate/size.peak_bitrate/
# size.overhead all auto-skip as `skipped:partial_scan` when
# PacketScanResult::partial is true -- a bitrate or overhead ratio derived
# from a truncated sweep is a confidently wrong number. size.file is the
# one exception: it is a property of the FILE, not of the scan, so it
# reports independently of PacketScan's own completeness.

# The container's byte size on disk, at global scope. `±%` tolerance with a
# tighter override for `remux`/`strict_bitexact` (03-CHECK-ROSTER.md): a
# remux or bit-exact re-encode changing size at all is itself suspicious,
# while ordinary encoder-to-encoder variation is expected within 3%/8%.
[[check]]
id = "size.file"
group = "size"
semantic = "tol"
unit = "percent"
value_kind = "int64"
severity = "fail"
tolerance = "3%,8%"

[check.profile_tolerance]
strict_bitexact = "0.5%"
remux = "0.5%"

# Per-stream, `byte_total * 8 / dts_span_seconds` kept as an exact
# RationalValue (never pre-divided) -- a directly measured rate, never
# `estimated` (unlike container.ts.pcr_interval's mux-rate-derived
# counterpart). Auto-skips `skipped:partial_scan` under D-02, and
# `skipped:no_timing_data` when every packet on the stream lacks a DTS.
[[check]]
id = "size.stream_bitrate"
group = "size"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "fail"
tolerance = "3%,10%"

# Per-stream, the MAXIMUM byte sum over any 1-second window (100ms step) of
# a stream's own DTS-in-ticks axis, doubled to bits and kept as an exact
# RationalValue -- doc 06's own "buffer/VBV compatibility tell". Windowing
# is pure integer arithmetic (checked_mul/checked_add/checked_div,
# compare_ticks_checked) so the result is byte-identical across platforms.
# Auto-skips `skipped:no_timing_data` when every packet lacks a DTS, and
# `skipped:insufficient_data` when the stream's own DTS span is shorter
# than one window; `skipped:partial_scan` under D-02.
[[check]]
id = "size.peak_bitrate"
group = "size"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "fail"
tolerance = "5%,15%"

# `(file_bytes - Sum of per-stream byte_total) / file_bytes`, kept as an
# exact RationalValue, global scope -- a muxer efficiency drift tell
# (`info` severity, doc 06). A payload sum that exceeds the file's own size
# (a crafted or otherwise inconsistent input) skips `insufficient_data`
# rather than reporting a negative overhead. Auto-skips
# `skipped:partial_scan` under D-02.
[[check]]
id = "size.overhead"
group = "size"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "info"
tolerance = "5%"

# Phase 4's tracer (04-01-PLAN.md Task 2, PROBE-03/VIDEO-05), src/analyzers/
# video/gop.cpp. The median keyframe-to-keyframe access-unit distance,
# derived from ParserScanResult::key_frame flags -- Pass::parser_scan's own
# first production consumer, fused into the SAME av_read_frame sweep
# PacketScan already performs (never a second sweep -- see
# src/probe/orchestrator.cpp's own comment on Pass::parser_scan). Kept as
# an exact RationalValue (num=median distance, den=1), never pre-divided.
# Approved at 04-CHECK-ROSTER.md (the frozen Phase-4 id roster). Skip-reason
# vocabulary: `insufficient_data` (fewer than two keyframes on the stream),
# `no_parser` (VIDEO-12 -- a codec with no registered libav parser),
# `partial_scan` (D-02 -- either PacketScan or ParserScan truncated).
[[check]]
id = "video.gop.length"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "fail"
tolerance = "10%"

# 04-06-PLAN.md (VIDEO-01, VIDEO-02), src/analyzers/video/stream_params.cpp
# -- the five per-video-stream identity checks: what codec, what profile,
# what level, what resolution, and how many frames. Approved at
# 04-CHECK-ROSTER.md (the frozen Phase-4 id roster). All five are
# codec-scoped, not container-scoped (ContainerFamily::other): every one
# extracts directly from AVStream.codecpar after the header pass alone, no
# registered parser required -- none of the five ever emits
# skipped:no_parser (that skip reason is reserved for a check that needs a
# real libav parser, e.g. video.gop.length above).

# codecpar->codec_id -> avcodec_get_name. `transform`: an intentional
# transcode is expected to change the codec, hence `info` there.
[[check]]
id = "video.codec"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

[check.profile_severity]
transform = "info"

# codecpar->profile -> avcodec_profile_name when it resolves, the raw
# integer's decimal spelling when it does not (VIDEO-01-E2: two different
# unrecognised profiles must compare as different, never as one shared
# "unknown" word). The raw integer, including AV_PROFILE_UNKNOWN (-99), is
# always in evidence.
[[check]]
id = "video.profile"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

[check.profile_severity]
transform = "info"

# codecpar->level -> this project's own codec-specific human-string table
# (H.264 level_idc/10, HEVC general_level_idc/30, AV1's 2+idx/4 . idx%4);
# an uncovered codec or level renders its raw integer rather than guessing
# -- a wrong rendered string would be permanent once it enters a committed
# snapshot. HEVC tier is NOT folded into the rendered string:
# general_tier_flag is not exposed by any public libav surface reachable
# without a decode pass (docs/checks/video.level.md records the empirical
# finding in full; this phase has no decode pass, 04-CONTEXT.md D-08/D-09).
[[check]]
id = "video.level"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

[check.profile_severity]
transform = "info"

# codecpar->width/height as "WIDTHxHEIGHT". The first shipped check to
# declare transform_affected = true (src/compare/exact.cpp's own
# transform_active branch is the consumer) -- under `transform` with a
# declared expect.resolution, the candidate is compared against the
# derived target instead of against the baseline.
[[check]]
id = "video.resolution"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"
transform_affected = true

# Counted from the shared packet scan (or the parser scan's own
# access-unit count when available, preferred for codecs where one packet
# is not one access unit) -- NEVER read from AVStream::nb_frames, which
# rides in evidence only (VIDEO-02: a container-trusted count would not be
# comparable across container types). A zero-magnitude tolerance
# ("0frames"), not `exact`, so `--tol video.frame_count=2frames` stays
# meaningful. Skip-reason vocabulary: `partial_scan` (either scan
# truncated -- a count from an incomplete sweep is a confidently wrong
# number, D-02).
[[check]]
id = "video.frame_count"
group = "video"
semantic = "tol"
unit = "frames"
value_kind = "int64"
severity = "fail"
tolerance = "0frames"

# 04-07-PLAN.md (VIDEO-01, VIDEO-04), src/analyzers/video/stream_params.cpp
# -- the aspect-ratio pair, the container-vs-bitstream conflict, and the two
# frame-rate checks. Approved at 04-CHECK-ROSTER.md (the frozen Phase-4 id
# roster). All five are codec-scoped (ContainerFamily::other).

# The EFFECTIVE sample aspect ratio: AVStream::sample_aspect_ratio
# (container, e.g. mp4's own `pasp`) wins per libav's own resolution and
# doc 03's explicit instruction. A 0/1 in either position means unset,
# treated as 1:1 for comparison -- `unset` rides in evidence for whichever
# position actually was (VIDEO-01-E1: a stream declaring nothing must stay
# distinguishable in evidence from one explicitly declaring 1:1, even
# though both compare equal).
[[check]]
id = "video.sar"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "rational"
severity = "fail"

# width*sar_num / height*sar_den, reduced by the greatest common divisor,
# every step through the checked helpers -- never a non-integer division. A
# zero width/height/sar-denominator skips insufficient_data rather than
# reporting a rational this project would then have to render.
[[check]]
id = "video.dar"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "rational"
severity = "fail"

# VIDEO-04's third clause, its own check id (04-CHECK-ROSTER.md's own
# SAR-conflict resolution -- decided at the roster's checkpoint: a real,
# comparable, --explain-documented finding, same shape as
# container.ts.cc_discontinuities, not an evidence field on video.sar).
# Compares the EFFECTIVE (unset-normalized) container and bitstream SAR
# values: an unset container SAR resolving to the same effective ratio as
# an explicit bitstream one is NOT a conflict (VIDEO-04-E1 -- a conflict
# check that fires on every well-formed file is exactly the noise this
# project treats as P0). `info` severity: informational by design, never
# gates the exit code under normal severity policy.
[[check]]
id = "video.sar.conflict"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "info"

# avg_frame_rate as an exact RationalValue with the stream's own timebase --
# r_frame_rate rides in evidence. 30000/1001 vs 29.97 must never be compared
# as floats (doc 03's own line); this check never renders either value to a
# float at any point.
[[check]]
id = "video.frame_rate.declared"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "rational"
severity = "fail"

# D-05/D-06/D-07 (04-CONTEXT.md): the shared probe-level cadence
# derivation's (src/probe/cadence.h) mode interval, expressed as a rate --
# never a second sweep, never re-derived independently of
# derive_cadence. `±0.1%` is deliberately tight: a measured cadence that
# moves at all is usually a real rate change, not noise. Skip-reason
# vocabulary: `no_timing_data`/`insufficient_data` (from the derivation
# itself), `partial_scan` (D-02, ahead of both -- a rate derived from a
# truncated sweep is a confidently wrong number).
[[check]]
id = "video.frame_rate.measured"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "warn"
tolerance = "0.1%"

# 04-08-PLAN.md (VIDEO-03, VIDEO-07, VIDEO-08), src/analyzers/video/
# color.cpp -- video.pix_fmt and the five colour-identity checks. Approved
# at 04-CHECK-ROSTER.md (the frozen Phase-4 id roster). All six are
# codec-scoped (ContainerFamily::other), extracted directly from
# AVStream.codecpar after the header pass alone -- no scan of any kind
# needed.

# av_get_pix_fmt_name of the FOLDED pixel format (VIDEO-03's yuvj-trap
# fold, detail::fold_pix_fmt_range) -- the five deprecated yuvj* names
# fold to their plain counterpart before this value is computed, so a
# yuvj420p file and an equivalent yuv420p-with-full-range file compare
# EQUAL here; the range delta itself is owned solely by the colour-range
# check below. `transform`: an intentional transcode is expected to change the
# pixel format, hence `info` there, matching video.codec's own reasoning.
[[check]]
id = "video.pix_fmt"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

[check.profile_severity]
transform = "info"

# av_color_range_name of the EFFECTIVE colour range after
# detail::fold_pix_fmt_range's SAME fold seam video.pix_fmt reads above
# (VIDEO-03) -- never a second, independently-written branch, which is
# what makes "yuvj420p vs yuv420p+full-range produces ZERO findings, but
# yuvj420p vs yuv420p+limited-range produces EXACTLY ONE (this check)" a
# provable property rather than an accident of two branches agreeing.
#
# DELIBERATELY carries NO [check.profile_severity] and NO
# [check.profile_tolerance] sub-table of any kind, in ANY profile,
# including `transform` -- VIDEO-07 and doc 03 section 5 require this
# check to fail in EVERY profile with no exceptions: preserving colour
# intent through an intentional transformation is exactly the invariant
# the `transform` profile exists to protect. Do NOT add a `transform`
# demotion here for symmetry with video.pix_fmt's own `info` override
# above -- that would silently break this guarantee. The absence of a
# declared override IS the mechanism (04-CHECK-ROSTER.md's own scope
# decision on this id).
[[check]]
id = "video.color.range"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 04-08-PLAN.md Task 2 (VIDEO-07, VIDEO-08): the remaining three colour-
# primaries/transfer-characteristic/matrix identity checks, each a DIRECT
# codecpar field rendered through its own av_color_*_name counterpart --
# no fold, no seam. `unspecified` compares as its OWN value in both
# directions (VIDEO-08): no wildcard, no absent-treated-as-match. This is
# a deliberate omission of an "obvious" convenience, not an oversight.
[[check]]
id = "video.color.primaries"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# av_color_transfer_name(codecpar->color_trc) -- see
# docs/checks/video.color.transfer.md's own "Why it matters" for PQ
# (smpte2084) and HLG (arib-std-b67) named explicitly.
[[check]]
id = "video.color.transfer"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# av_color_space_name(codecpar->color_space) -- libav's own field/enum
# name is "color_space" (AVColorSpace); this project's own id and doc 03
# call the identical YCbCr conversion matrix "matrix".
[[check]]
id = "video.color.matrix"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# av_chroma_location_name(codecpar->chroma_location) -- `warn`, not
# `fail`, per 04-CHECK-ROSTER.md: a scaler-chain drift tell, real but
# rarely a shipping blocker on its own (see
# docs/checks/video.color.chroma_loc.md's own "### Tune"). `unspecified`
# (this field's own UNSPECIFIED spelling, distinct from the other three
# fields' "unknown") compares as its own value in both directions, same
# VIDEO-08 rule as the three checks above.
[[check]]
id = "video.color.chroma_loc"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "warn"

# 04-09-PLAN.md Task 1 (VIDEO-05, VIDEO-12), src/analyzers/video/gop.cpp --
# the IDR cadence and the open/closed GOP classification, extending
# video.gop.length above. Approved at 04-CHECK-ROSTER.md (the frozen
# Phase-4 id roster). Classification reads the leading VCL NAL type
# directly, NEVER the `key_frame` boolean (04-RESEARCH.md Priority
# Finding 3: HEVC sets key_frame for every IRAP including CRA_NUT, and the
# H.264 parser's own ref-count heuristic can mark a non-IDR I slice as a
# keyframe too) -- see docs/checks/video.gop.closed.md's own "Why it
# matters" for the segment-alignment consequence this is meant to catch.
# Skip-reason vocabulary, shared by both ids below: `insufficient_data`
# (fewer than two IDRs for the interval; no random-access point at all for
# the classification; or more access units than
# detail::kMaxAccessUnitsForGopClassification's own bound, T-4-40),
# `no_parser` (either no registered libav parser, or a codec with no NAL
# layer at all -- evidence names the codec in the second case), and
# `partial_scan` (D-02, checked ahead of everything else).
[[check]]
id = "video.gop.idr_interval"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "fail"
tolerance = "10%"

# Split from video.gop.idr_interval above (04-CHECK-ROSTER.md's own one-
# semantic-per-id rule -- doc 03's single row words both an interval
# tolerance and an exact open/closed classification, which a CheckDef
# cannot carry at once). The classification itself, as an exact string
# ("open"/"closed"), with the three random-access-point-kind counts in
# evidence so a reader can see WHY the classification came out as it did.
[[check]]
id = "video.gop.closed"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 04-09-PLAN.md Task 2 (VIDEO-05), src/probe/parser_scan.{h,cpp}'s own
# bounded Exp-Golomb SPS reader -- the H.264 SPS's own `max_num_ref_frames`
# field. No public libav accessor exposes this value (this plan's own
# flagged assumption A1: `AVCodecParameters` carries no reference-frame
# count, and `AVCodecParserContext` does not publish the H.264 parser's
# own internal `sps->ref_frame_count` either). `warn`, not `fail`
# (04-CHECK-ROSTER.md): a real, worth-noticing reference-structure signal,
# not on its own a shipping blocker. Skip-reason vocabulary: `no_parser`
# (no registered libav parser, OR a codec this reader does not extract a
# reference count from -- mpeg4/mpeg2video have no SPS concept at all,
# HEVC's own SPS is a structurally different layout this reader does not
# parse -- evidence names the codec either way), `unparsed_mechanism` (a
# truncated, unreadable, or scaling-list-carrying SPS, matching PROBE-09's
# established degradation shape), `partial_scan` (D-02).
[[check]]
id = "video.gop.refs"
group = "video"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "warn"

# 04-09-PLAN.md Task 2 (VIDEO-01/VIDEO-05, VIDEO-12), src/analyzers/video/
# frame_types.cpp -- the I/P/B (and S/SI/SP/BI) picture-type distribution,
# as a proportion histogram (`dist`'s own normalisation happens at
# comparison time -- this check emits raw bin COUNTS, never a pre-divided
# percentage). Bin names are libav's own single-letter picture-type
# spelling (`av_get_picture_type_char`, `probe/parser_scan.h`'s own
# `picture_type_name`). VIDEO-12's own degradation: a codec with no
# registered parser still reports a keyframe-vs-non-keyframe two-bin
# histogram from `PacketRecord::flags`' own keyframe bit, never a skip --
# doc 03 section 1's own "frame-type distribution DEGRADES to
# keyframe-flag granularity" wording. `warn` baseline, escalated to `fail`
# under `strict_bitexact`/`remux` (an unexpected B-picture disappearance is
# exactly the silent configuration regression those two profiles exist to
# catch) and widened to `10%` under `hw_encoder` (hardware rate control
# legitimately redistributes picture types more than a software encoder
# would, doc 03 section 5).
[[check]]
id = "video.frame_types"
group = "video"
semantic = "dist"
unit = "percent"
value_kind = "histogram"
severity = "warn"
tolerance = "5%"

[check.profile_severity]
strict_bitexact = "fail"
remux = "fail"

[check.profile_tolerance]
hw_encoder = "10%"

# 04-10-PLAN.md (VIDEO-06), src/analyzers/video/interlace.cpp -- the
# declared field order (codecpar->field_order) cross-checked against the
# PER-ACCESS-UNIT field order ParserScanResult records, never reported as
# the value without recording whether that cross-check was possible.
# Approved at 04-CHECK-ROSTER.md (the frozen Phase-4 id roster). The
# observed value wins whenever a cross-check was possible; a uniform
# observed value that disagrees with the declared one is still the
# compared value, with the disagreement recorded in evidence only (never
# gating the comparison). Non-uniform observed content is reported as
# `mixed`, with one exact num/den rational proportion per distinct
# observed field order in evidence -- never a floating-point percentage
# (T-4-45). Skip-reason vocabulary: `partial_scan` (either scan
# truncated, D-02, checked ahead of everything else). Deliberately never
# `no_parser` -- unlike video.gop.*/video.frame_types above, a codec with
# no registered parser (or a registered parser that never sets
# field_order) still reports the declared value, with evidence recording
# that no per-frame cross-check was possible (VIDEO-06-E1).
[[check]]
id = "video.interlace"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 04-11-PLAN.md (VIDEO-09), src/analyzers/video/hdr.cpp -- HDR10 mastering-
# display metadata read from codecpar->coded_side_data
# (AV_PKT_DATA_MASTERING_DISPLAY_METADATA), populated at DEMUX time (mov.c's
# own av_packet_side_data_add path for the mp4 `mdcv` box, D-09) -- no
# decode pass exists in this phase (D-08). `presence` semantic: Absent{}
# when this codec cannot carry frame-level HDR metadata either (mpeg4,
# mpeg2video -- an ordinary, permanent absence); `skipped:requires_decode`
# when it COULD (HEVC, AV1) but the stream-level source was empty -- the
# precedence seam's second arm (first-frame side data) is declared in
# hdr.cpp's own resolve_hdr_source but not wired until Phase 7. Approved at
# 04-CHECK-ROSTER.md.
[[check]]
id = "video.hdr.mdcv"
group = "video"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "fail"

# Split from video.hdr.mdcv (the presence check above) per src/compare/
# presence.cpp's own documented "a value comparison is a separate tol check
# on the same extraction" rule (04-CHECK-ROSTER.md's own addition
# rationale). Max luminance compared under a five percent tolerance (doc 03
# section 4) -- a pipeline that re-derives mastering metadata from pixels
# legitimately drifts slightly, so treating any nonzero delta as a
# regression would be a false positive. Skips `requires_decode` (never
# Absent{} -- src/compare/tol.cpp turns Absent into Status::error) when
# mdcv is not present at the stream level, is present but its own
# has_luminance flag is false, or its max_luminance denominator is invalid
# (T-4-49).
[[check]]
id = "video.hdr.mdcv.luminance"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "rational"
severity = "fail"
tolerance = "5%"

# Split from video.hdr.mdcv, same rationale as .luminance above. Eight
# chromaticities (the three display primaries plus the white point, each an
# x/y pair) compared `exact` over a canonical string of each rational
# QUANTISED to the 0.0002 grid via integer arithmetic
# (detail::quantize_chromaticity) -- the design doc's absolute tolerance
# expressed as fixed-epsilon integer quantisation, never a literal ±0.0002
# `tol` (a `tol` check compares exactly one scalar; eight chromaticities
# need one canonical value, 04-CHECK-ROSTER.md's own approved resolution of
# flagged assumption A1). Skips `requires_decode` under the identical
# conditions as .luminance, substituting has_primaries for has_luminance.
[[check]]
id = "video.hdr.mdcv.primaries"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 04-11-PLAN.md (VIDEO-09), src/analyzers/video/hdr.cpp -- HDR10 content-
# light metadata (AVContentLightMetadata, AV_PKT_DATA_CONTENT_LIGHT_LEVEL)
# -- the SAME stream-level-only extraction and the SAME could/could-not-
# carry distinction as video.hdr.mdcv above, sharing one extraction seam
# and one codec-capability decision (hdr.cpp's own resolve_hdr_source /
# detail::could_carry_frame_level_hdr, never a second, independently-
# written copy).
[[check]]
id = "video.hdr.cll"
group = "video"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "fail"

# Split from video.hdr.cll (the presence check above) for MaxCLL --
# AVContentLightMetadata's own plain unsigned integer, cd/m^2 directly (no
# rational wrapping, unlike the mastering-display family -- 04-RESEARCH.md's
# own "Anti-Patterns to Avoid": the two families are not symmetric). Five
# percent tolerance, same reasoning as video.hdr.mdcv.luminance's own
# comment.
[[check]]
id = "video.hdr.cll.max"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "int64"
severity = "fail"
tolerance = "5%"

# Split from video.hdr.cll for MaxFALL -- its OWN id, never evidence riding
# on video.hdr.cll.max, so a pipeline that halved MaxFALL alone is still
# caught (04-CHECK-ROSTER.md's own addition rationale).
[[check]]
id = "video.hdr.cll.avg"
group = "video"
semantic = "tol"
unit = "percent"
value_kind = "int64"
severity = "fail"
tolerance = "5%"

# 04-12-PLAN.md (VIDEO-09's third HDR family), src/analyzers/video/hdr.cpp --
# the Dolby Vision configuration record, read from codecpar->coded_side_data
# (AV_PKT_DATA_DOVI_CONF), reusing the SAME resolve_hdr_source seam
# mdcv/cll share -- no second, independently-written codec-capability
# table. `presence`: whether a dvcC/dvvC-derived configuration record is
# present at all.
[[check]]
id = "video.hdr.dovi"
group = "video"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "fail"

# Split from video.hdr.dovi (the presence check above), same rationale as
# video.hdr.mdcv.luminance/.primaries -- a value comparison is a separate
# check on the same extraction. `exact` over a canonical
# profile/level/rpu/el/bl string (docs/checks/video.hdr.dovi.config.md's
# own Tune section documents the field order). v1 compares the
# configuration record only; per-frame RPU diffing is explicitly out of
# scope (04-CONTEXT.md's own Deferred Ideas).
[[check]]
id = "video.hdr.dovi.config"
group = "video"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 04-12-PLAN.md (VIDEO-10, D-10), src/analyzers/video/hdr.cpp -- the
# incoherence guard: whether the transfer characteristic and the presence
# of mastering-display/content-light metadata agree. `state` semantic
# (04-CHECK-ROSTER.md's resolved checkpoint, src/compare/state.cpp): fires
# whenever EITHER side's value is one of the two flagged (incoherent)
# values, so two files that SHARE an incoherence still report it rather
# than comparing away to `pass` under `exact`'s baseline-equality rule
# (VIDEO-10's own "even when both files share it"). `info` severity, and
# DELIBERATELY no [check.profile_severity]/[check.profile_tolerance] of any
# kind, in ANY profile -- this check never gates the exit code, by design,
# not by omission (mirrors video.color.range's own "the absence of a
# declared override IS the mechanism" precedent).
[[check]]
id = "video.hdr.coherence"
group = "video"
semantic = "state"
unit = "none"
value_kind = "string"
severity = "info"
flagged_values = ["hdr_meta_sdr_transfer", "pq_without_mdcv"]

# 05-01-PLAN.md (TIME-01/TIME-03), src/analyzers/timeline/start_duration.cpp
# -- this phase's tracer, approved at 05-CHECK-ROSTER.md. D-03: ONE
# Scope{Kind::global} measurement holds the file's earliest presentation
# time; ONE Scope{Kind::video/audio/subtitle/data} measurement per
# timestamped stream holds that stream's own first presentation PTS MINUS
# the global origin -- never a per-stream absolute PTS. This is what makes
# a whole-file shift (an MP4 stream-copied to MPEG-TS, which the TS muxer
# delays by its own 1.4s default) report ONE global finding instead of one
# per stream, for one cause. Skip-reason vocabulary, in priority order:
# `partial_scan` (Phase 3 D-02, ahead of everything -- a truncated
# PacketScan makes even the GLOBAL scope's own claim of "earliest" provably
# wrong), `no_timing_data` (a stream, or the whole file, with no real PTS
# at all -- TIME-01's `AV_NOPTS_VALUE`-as-`Absent{}` requirement), then
# `insufficient_data` (an overflow anywhere in the checked cross-timebase
# arithmetic -- T-05-01). `strict_bitexact`/`remux`'s tighter 1ms tolerance
# reflects that a byte-exact re-encode or a stream-copy remux should move
# the origin by nothing at all.
[[check]]
id = "timeline.start"
group = "timeline"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
tolerance = "5ms,20ms"

[check.profile_tolerance]
strict_bitexact = "1ms"
remux = "1ms"

# 05-04-PLAN.md (TIME-01/TIME-03), src/analyzers/timeline/start_duration.cpp
# -- the duration TRIPLE: container-declared (AVFormatContext->duration),
# stream-declared (AVStream->duration), computed (last presentation end -
# first PTS, doc 04 section 1.3's own reconstructed-packet-duration rule).
# Compared value is the COMPUTED member; the other two, plus
# `duration_source` (declared/reconstructed) and `absent_members`, ride in
# evidence -- an absent member is reported absent, NEVER substituted for
# another (T-05-13/T-05-16). **Deviation from doc 04's literal "±1 frame"**
# (05-CHECK-ROSTER.md): 40ms (one frame at 25fps) is a FIXED named
# constant -- a frame-derived threshold is frame-rate-dependent, ruled out
# by D-08's data-dependent-threshold prohibition. Skip-reason vocabulary,
# same priority order as timeline.start: `partial_scan` first (Phase 3
# D-02), then `no_timing_data` (a stream with no real PTS at all), then
# `insufficient_data` (an overflow anywhere in the reconstruction/rescale
# arithmetic, T-05-14).
[[check]]
id = "timeline.duration"
group = "timeline"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
tolerance = "20ms,40ms"

# 05-04-PLAN.md (TIME-03, D-08, Phase 4 D-10's precedent), src/analyzers/
# timeline/start_duration.cpp -- the duration triple's OWN internal
# cross-check: whether the three members (container-declared,
# stream-declared, computed) agree with each other, within
# kDurationIncoherenceThresholdMs (40ms, the SAME "one frame at 25fps"
# constant timeline.duration's own tolerance uses). `state` semantic
# (mirrors video.hdr.coherence exactly, src/compare/state.cpp): fires
# whenever EITHER side's value is one of the three flagged pairs, so two
# files that SHARE an incoherence still report it rather than comparing
# away to `pass` under `exact`'s baseline-equality rule -- there is no
# delta to hang it on, and a shared defect is still a defect. `info`
# severity, and DELIBERATELY no [check.profile_severity]/
# [check.profile_tolerance] override of any kind, in ANY profile -- this
# check never gates the exit code, by design, not by omission (mirrors
# video.hdr.coherence's own identical precedent). Only a pair whose BOTH
# members are present is testable (T-05-13/T-05-16); an untestable or
# all-agreeing case emits the unflagged value, "coherent".
[[check]]
id = "timeline.duration.coherence"
group = "timeline"
semantic = "state"
unit = "none"
value_kind = "string"
severity = "info"
flagged_values = ["container_vs_stream", "container_vs_computed", "stream_vs_computed"]

# 05-05-PLAN.md (TIME-01/TIME-04), src/analyzers/timeline/monotonic.cpp --
# the count of `dts[i] <= dts[i-1]` violations per stream, in READ order,
# AFTER the 33-bit TS unwrap (05-02-PLAN.md) on a ContainerFamily::ts
# input. Packets carrying AV_NOPTS_VALUE on the DTS axis are EXCLUDED from
# the count, never coerced to a value -- a stream of entirely-absent DTS
# reports `skipped:no_timing_data`, never a fabricated `0` clean bill of
# health (TIME-01). **Deviation from doc 04's literal "count exact 0"**
# (05-CHECK-ROSTER.md): `tol`/`count` with tolerance `"0"`, not `exact` --
# a zero-magnitude absolute tolerance behaves identically to exact equality
# while leaving `--tol timeline.dts_monotonic=2` meaningful for a pipeline
# with known, accepted noise (mirrors Phase 4's `video.frame_count`
# "0frames" precedent). Runs on every stream carrying timestamps EXCEPT
# `Scope::Kind::subtitle` (05-CHECK-ROSTER.md's own scope decision).
# Skip-reason vocabulary, in priority order: `partial_scan` (Phase 3 D-02,
# ahead of everything), then `no_timing_data` (no real DTS at all on this
# stream), then `insufficient_data` (the TS unwrap overflowed, T-05-18).
[[check]]
id = "timeline.dts_monotonic"
group = "timeline"
semantic = "tol"
unit = "count"
value_kind = "int64"
severity = "fail"
tolerance = "0"

# 05-05-PLAN.md (TIME-01/TIME-04), src/analyzers/timeline/monotonic.cpp --
# the count of duplicate presentation PTS values per stream, found by
# sorting a LOCAL index view by PTS (never read order) and counting
# adjacent equal values. Same sentinel-exclusion, TS-unwrap-first and
# subtitle-scope-exclusion rules as `timeline.dts_monotonic` above, and the
# same **deviation from doc 04's literal "count exact 0"**: `tol`/`count`
# with tolerance `"0"`, not `exact`, for the identical
# zero-magnitude-tolerance reasoning. Same skip-reason priority order as
# `timeline.dts_monotonic` above.
[[check]]
id = "timeline.pts_unique"
group = "timeline"
semantic = "tol"
unit = "count"
value_kind = "int64"
severity = "fail"
tolerance = "0"

# 05-06-PLAN.md (TIME-04, D-08), src/analyzers/timeline/monotonic.cpp --
# spans where the interval between two consecutive PRESENTATION-order
# timestamps strictly exceeds `max(kGapNominalMultiplier x nominal,
# declared_duration + kGapDeclaredDurationSlackTicks)`. `nominal` comes
# from the ONE shared `derive_cadence` mode interval (src/probe/cadence.h,
# PROBE-10) -- never a second interval computation. `declared_duration` is
# the preceding packet's own reconstructed duration
# (`detail::reconstruct_packet_durations`, doc 04 section 1.3, already
# landed by 05-04-PLAN.md -- called, never re-implemented). Both `2` and
# `1 tick` are fixed named constants (D-08): a detection parameter changes
# the MEASURED span list, unlike a tolerance, which only changes the
# verdict -- making either configurable would require fingerprint
# recording plus mismatch-skip machinery deliberately deferred past v1.
# `span` semantic (`src/compare/span.cpp`): an introduced span gates on
# this check's own severity; a removed span is always `info`, never
# gating. On a ContainerFamily::ts input, both the interval walk and the
# duration reconstruction run over the UNWRAPPED presentation timeline
# (05-02-PLAN.md's `unwrap_ts_timestamps`, doc 04 section 1.2) -- a
# genuine mid-file 33-bit wrap produces ZERO spans attributable to the
# wrap itself (doc 04 section 5's own TS-wrap acceptance criterion). Runs
# on every stream carrying timestamps EXCEPT `Scope::Kind::subtitle`
# (05-CHECK-ROSTER.md's own scope decision, docs/checks/timeline.gaps.md
# states the reason) -- a subtitle track's intentionally sparse timing
# would false-positive under a rule tuned for audio/video. Skip-reason
# vocabulary, in priority order: `partial_scan` (Phase 3 D-02, ahead of
# everything -- a gap list from an incomplete sweep is silently MISSING
# exactly the gaps at the truncation point), `no_timing_data` (no real PTS
# at all on this stream), then `insufficient_data` (the shared cadence
# derivation did not report `ok`, or any checked-arithmetic step
# overflowed -- never a fallback nominal or a fabricated span).
[[check]]
id = "timeline.gaps"
group = "timeline"
semantic = "span"
unit = "ms"
value_kind = "span_list"
severity = "fail"

# 05-06-PLAN.md (TIME-02, D-08, Phase 4 D-10's precedent), src/analyzers/
# timeline/monotonic.cpp -- **Addition** (05-CHECK-ROSTER.md): doc 04
# section 1.2's own "wrap events themselves are recorded (info)" sentence,
# given its own check id since a shared-condition note with no delta to
# hang it on needs the `state` semantic (mirrors `video.hdr.coherence`
# and `timeline.duration.coherence` exactly). Fires the flagged value
# `ts_33bit_wrap` when a `ContainerFamily::ts` stream's raw PTS/DTS
# sequence exhibits at least one wrap event under
# `unwrap_ts_timestamps`'s own asymmetric rule -- the unflagged value is
# `no_wrap`. Because `state`'s own `pass` means NEITHER side was flagged
# (src/compare/state.cpp, WR-02 precedent), a pair whose BOTH files wrap
# still reports the flagged value as a non-`pass` finding -- there is no
# delta to hang it on, and a shared wrap is still a real property worth
# surfacing, per doc 04's own "a candidate that wraps where baseline
# didn't usually means a start-offset change upstream" reasoning. Evidence
# carries `wrap_count`, and -- when `wrap_count > 0` -- the first wrapping
# packet's own index plus its RAW and UNWRAPPED values (TIME-02's "raw
# values are preserved in evidence" requirement, satisfied concretely).
# On a non-TS input this check reports `skipped:not_applicable_container`
# -- the 33-bit wrap is an MPEG-TS-specific property of the 90kHz PES
# timestamp field, meaningless for MP4/Matroska. `skipped:insufficient_data`
# when the unwrap's own running-offset arithmetic overflows (T-05-05).
[[check]]
id = "timeline.wrap_events"
group = "timeline"
semantic = "state"
unit = "none"
value_kind = "string"
severity = "info"
flagged_values = ["ts_33bit_wrap"]

# 05-07-PLAN.md (TIME-02/TIME-04, D-08), src/analyzers/timeline/discontinuities.cpp
# -- doc 04 section 2's own `timeline.discontinuities` row: presentation-time
# jumps STRICTLY EXCEEDING the fixed `kDiscontinuityThresholdMs` (250ms) that
# are NOT explained by container structure. **Deviation from doc 04's literal
# "(config)"** (D-08): a fixed named constant in v1, never a tunable knob -- a
# detection parameter changes the MEASURED span list, unlike a tolerance,
# which only changes the verdict; a configurable threshold would require
# fingerprint recording plus mismatch-skip machinery (the `--sample N`
# shape) deliberately deferred past v1. On a `ContainerFamily::ts` input the
# flag is `discontinuity_indicator=1` on the transport packet attributable
# to the jump via `ts_scan`'s own recorded byte offsets (05-07-PLAN.md
# Task 1) joined by `PacketRecord::pos` -- never a second byte-level TS
# parser (T-05-30). UNflagged TS jumps and every non-TS jump land HERE,
# gating; the flagged split lives at `timeline.discontinuities.flagged`,
# `info` severity, below. `span` semantic (`src/compare/span.cpp`): an
# introduced span gates on this check's own severity; a removed span is
# always `info`, never gating. Runs on every stream carrying timestamps
# EXCEPT `Scope::Kind::subtitle` (same scope as `timeline.gaps`).
# Skip-reason priority: `partial_scan` (Phase 3 D-02, ahead of everything --
# TS-scoped: also when `TsScanResult::complete` is false, since the
# discontinuity_indicator offset list itself is then unreliable), then
# `no_timing_data` (no real PTS at all on this stream), then
# `insufficient_data` (an overflow anywhere in the checked interval/
# threshold arithmetic, the TS unwrap itself overflowing, or --
# TS-scoped -- `PidStats::discontinuity_offsets_truncated` being set:
# T-05-29, a classification built on a partial flag list could silently
# demote real breakage to `info`, so both ids skip rather than classify).
[[check]]
id = "timeline.discontinuities"
group = "timeline"
semantic = "span"
unit = "ms"
value_kind = "span_list"
severity = "fail"

# 05-07-PLAN.md (TIME-02, D-08, Phase 3's container.ts.cc_errors/
# .cc_discontinuities split precedent), src/analyzers/timeline/
# discontinuities.cpp -- **Addition** (05-CHECK-ROSTER.md): split from doc
# 04's `timeline.discontinuities` row -- TS packets under
# `discontinuity_indicator=1` are FLAGGED structure (the muxer declared the
# break on purpose, e.g. a splice point), `info` severity, never gating.
# Attribution rule (A2, docs/checks/timeline.discontinuities.flagged.md):
# `PacketRecord::pos` is a PES-packet byte offset; the flag lives on a
# 188-byte transport packet inside that PES packet's own byte range, so a
# jump is flagged when a recorded `discontinuity_indicator` offset falls
# within the demuxed packet's own `[pos, next_pos)` range -- an
# approximate-at-the-PES-boundary attribution, documented as such rather
# than claimed as per-transport-packet precision. On a non-TS input this
# check reports `skipped:not_applicable_container` -- never an empty span
# list, because "no flagged structure exists here" and "this container
# cannot express flagged structure" are different facts. Same skip-reason
# priority as `timeline.discontinuities` above, substituting
# `not_applicable_container` for the non-TS case.
[[check]]
id = "timeline.discontinuities.flagged"
group = "timeline"
semantic = "span"
unit = "ms"
value_kind = "span_list"
severity = "info"

# 05-08-PLAN.md (TIME-05), src/analyzers/timeline/jitter_vfr.cpp --
# 05-CHECK-ROSTER.md's own Discretion resolution: ONE id, not two. Sigma
# (the standard deviation of the interval distribution around the stream's
# own mode interval, D-07's `Cadence::mode_interval_ticks`) is the compared
# value, reported as an EXACT fixed-point `RationalValue` (denominator
# `2^kJitterSigmaFixedShift`, `core/rational.h`) -- never a rounded real,
# never computed via `std::sqrt` on a double anywhere in the compared-value
# path (a portable integer bit-doubling square root,
# `detail::Int128Accum::try_isqrt`, computes the root exactly). The maximum
# absolute deviation rides in evidence on this SAME id, never a second
# check -- doubling a single jittery stream into two findings is exactly
# the D-01/D-02 noise concern the roster's own Discretion note names.
# `skipped:vfr` (never a sigma) on a stream `derive_cadence` (PROBE-10, the
# ONE shared cadence primitive, consumed once per stream by both this check
# and `timeline.vfr_profile` below) classifies as VFR -- a jitter
# statistic computed around a nominal interval that does not exist for a
# genuinely variable-rate stream is not a measurement, it is noise. Runs
# on every stream carrying timestamps EXCEPT `Scope::Kind::subtitle`
# (mirrors `timeline_monotonic_analyzer()`'s own scope decision). Skip-
# reason priority: `partial_scan` (Phase 3 D-02, ahead of everything),
# then whatever `derive_cadence` itself reports (`no_timing_data`/
# `insufficient_data`), then `vfr` (this check only), then
# `insufficient_data` again for a sigma-specific overflow (T-05-34: a
# crafted interval distribution whose accumulated sum of squared
# deviations cannot narrow to int64_t -- degrades honestly, never a
# wrapped sigma).
[[check]]
id = "timeline.jitter"
group = "timeline"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
tolerance = "0.5ms,2ms"

# 05-08-PLAN.md (TIME-05, D-06), src/analyzers/timeline/jitter_vfr.cpp --
# a six-bin histogram (`on_grid`, `one_tick`, `one_percent`, `two_x`,
# `three_x`, `longer`, 05-CHECK-ROSTER.md's own fixed, approved labels)
# over every consecutive-interval deviation on the SAME axis
# `derive_cadence` used, keyed on the deviation from the stream's OWN grid
# (D-05's exact rational `Cadence::ideal_interval_num/den`), never raw
# ticks -- the property that makes the identical content bin identically
# whether it is stored as an MP4 (a coarse timebase) or remuxed to
# Matroska (a 1ms timebase): a raw-tick histogram would bin the SAME
# real-world jitter into different buckets purely because the two
# containers store the interval as different tick counts, which is
# exactly the false-positive class D-06 exists to prevent. Runs
# REGARDLESS of `Cadence::klass` (unlike `timeline.jitter` above, which
# skips entirely on VFR) -- the histogram itself is what tells a reader
# the stream is not constant-rate, mirroring
# `video.frame_rate.measured`'s own "a VFR classification does not skip
# this check" precedent. Runs on every stream carrying timestamps EXCEPT
# `Scope::Kind::subtitle` (same scope as `timeline.jitter` above). Skip-
# reason priority: `partial_scan` (Phase 3 D-02, ahead of everything),
# then whatever `derive_cadence` itself reports
# (`no_timing_data`/`insufficient_data`) -- IDENTICAL to `timeline.jitter`
# above for these two reasons (never letting one id compute a real value
# while the other skips for a DIFFERENT reason on the SAME stream), then
# `insufficient_data` again for a bin-classification overflow (a crafted
# ideal/interval pair whose cross-multiplication cannot fit int64_t).
[[check]]
id = "timeline.vfr_profile"
group = "timeline"
semantic = "dist"
unit = "percent"
value_kind = "histogram"
severity = "warn"
tolerance = "2%"

# 05-09-PLAN.md (TIME-06/TIME-09/TIME-10, D-09/D-10/D-11), src/analyzers/
# timeline/av_sync.cpp -- the signed offset between the first audible
# sample (audio-side priming-adjusted, D-09's resolver) and the first
# visible frame of the primary video stream; positive means audio late
# (doc 04 section 2's own sign convention). D-09: priming is read from
# what the demuxer already exposes without decoding -- packet-level
# `AV_PKT_DATA_SKIP_SAMPLES` checked FIRST, `codecpar->initial_padding` as
# fallback (05-RESEARCH.md's own verified finding: MP4 signals priming
# ONLY via the packet-level side data). D-10: the fingerprint stores the
# RAW offset, the ADJUSTED offset and a structured `priming`
# {state,source,samples} object per side; `comparison_basis` records this
# side's own preference, and src/compare/tol.cpp's generic evidence-driven
# override (Rule 2 addition) swaps the compared magnitude to
# `adjusted_offset_ms` only when BOTH sides agree -- raw-to-raw whenever
# either side's priming is unknown, so a mixed MP4-vs-TS pair compares
# something meaningful instead of an adjusted number against an
# unadjusted one. D-11: unknown priming NEVER softens severity or widens
# tolerance -- the uncertainty is visible structured evidence, not a
# weaker gate. Primary-stream selection: the first video-scoped stream, by
# array order; one measurement per audio stream. No audio, or no video, at
# all: `skipped:insufficient_data`, never silence. Skip-reason priority:
# `partial_scan` (Phase 3 D-02, ahead of everything), then
# `insufficient_data` for every other "nothing to measure" case.
[[check]]
id = "timeline.av_offset"
group = "timeline"
semantic = "tol"
unit = "ms"
value_kind = "rational"
severity = "fail"
tolerance = "5ms,20ms"

# 05-10-PLAN.md (TIME-07/TIME-08), src/analyzers/timeline/av_sync.cpp --
# doc 04 section 3's flagship A/V drift algorithm, one `fit_drift` call per
# audio stream producing TWO ids from the ONE fit (D-04, locked at the
# 05-01 roster checkpoint: an id comparing rate alone would never fire on
# a clean step; a THIRD id for end delta would turn one drift report into
# three findings for a reader to reconcile by hand). This id is the RATE,
# ms/min, an exact `RationalValue` from `Int128Accum::try_reduce_ratio`'s
# GCD-reduced slope -- never a pre-divided float. D-07's dual gate: the
# rate is ALWAYS published, but a non-pass verdict additionally requires
# the accumulated END DELTA (evidence `end_delta_ms`) to clear the SAME 2
# ms epsilon `fit_drift`'s own classification uses (kDriftEpsilonMs,
# analyzers.h) -- src/compare/tol.cpp's generic evidence-shape override
# (mirrors D-10's `timeline.av_offset` precedent immediately above)
# forces `pass` when the end delta does not clear it, regardless of the
# rate delta. Reason: 0.2 ms/min accumulated over the ten-minute reference
# file is exactly 2 ms -- WITHOUT the dual condition, ordinary timebase
# rounding on a short clip would false-positive on a rate that is not a
# real drift (P0: false positives are worse than a missed one). Evidence
# also carries `residual_max_ms`, `comparison_basis` (the SAME
# raw-versus-adjusted basis `timeline.av_offset` chose for this side,
# D-10) and the full K=32
# `{k, t_v_ms, offset_ms}` trajectory (TIME-08) -- `05-RESEARCH.md`
# confirmed `Measurement::evidence` already round-trips through
# `src/core/snapshot.cpp` (read ~line 297, write ~line 356), so `compare`
# against a stored snapshot retains full trajectory fidelity, doc 04
# section 3 step 5. Skip-reason priority identical to `timeline.av_offset`
# immediately above: `partial_scan`, then `insufficient_data` (no audio,
# no video, too few usable checkpoints, or `fit_drift` itself refusing an
# unnarrowable/degenerate fit) -- never a wrapped or fabricated rate.
[[check]]
id = "timeline.av_drift"
group = "timeline"
semantic = "tol"
unit = "ms_per_min"
value_kind = "rational"
severity = "fail"
tolerance = "0.2ms/min"

# 05-10-PLAN.md (TIME-07/TIME-08), the SAME `fit_drift` call as
# `timeline.av_drift` immediately above -- this id is the CLASSIFIED
# PATTERN, three spellings exactly:
# `constant-offset` / `linear-drift` / `irregular`
# (`DriftPattern`, analyzers.h). D-04, locked and one-way at the 05-01
# roster checkpoint: exists so a step small enough to leave the fitted
# RATE under `timeline.av_drift`'s own 0.2 ms/min tolerance (a brief,
# large jump can average out to a shallow slope over a long file) still
# produces a finding a reader can act on -- the rate id alone would stay
# silent on exactly that case. `exact`/`string`, mirroring
# `video.pix_fmt`'s own shape immediately below in this file's git
# history (04-08-PLAN.md) -- no tolerance, any change of class gates.
# Same skip-reason priority as `timeline.av_drift`: both ids skip
# together, from the same `fit_drift` call, never independently.
# AMENDED 2026-09-18, UD-1 (05-23-PLAN.md, narrow-vocabulary per
# 05-STEP-DESIGN.md's `## Decision`): doc 04 section 3.4's fourth
# spelling, `step`, is withdrawn -- neither evaluated checkpoint-mapping
# design (05-21-SUMMARY.md D1/D2) reports a step at a location tied to
# the real splice, so a spliced trim now classifies `irregular` with its
# residual max instead. See docs/checks/timeline.av_drift.pattern.md and
# 05-CHECK-ROSTER.md's `## Amendments` for the full record.
[[check]]
id = "timeline.av_drift.pattern"
group = "timeline"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# 05-11-PLAN.md (TIME-11), src/analyzers/timeline/timecode.cpp -- SMPTE
# timecode PRESENCE from a QuickTime `tmcd` track, reachable from
# Pass::demux_header ALONE (05-RESEARCH.md Pattern 4: the MOV/MP4 demuxer
# resolves the tmcd track's starting timecode during
# avformat_find_stream_info itself, ZERO decode calls). `presence`
# semantic, `info` severity (doc 04's own table: "broadcast configs raise
# to fail via one --set"). A file with no tmcd track reports Absent{} --
# an explicit, comparable absence, never an empty string, so a timecode
# that DISAPPEARS between two builds is reported (TIME-11's empty edge).
# SkipReason::none in every case (an ordinary, real, permanent absence,
# never `skipped`). Evidence carries `source` ("tmcd"), `drop_frame`,
# `timecode_stream_index` and `unreachable_sources` -- the latter names
# AV_PKT_DATA_S12M_TIMECODE (no file-demuxer producer in this build,
# libavdevice is not linked) and MPEG-2 GOP timecode
# (AV_FRAME_DATA_GOP_TIMECODE, decode-only) with the reason
# "requires_decode", so a user asking why their broadcast/GOP timecode was
# not detected gets the answer from `mediadiff explain` (05-RESEARCH.md
# Pitfall 6). No separately-triggerable S12M id: DOC-03 requires a real
# trigger fixture, and none can exist for a source this build cannot ever
# reach (05-CHECK-ROSTER.md).
[[check]]
id = "timeline.timecode"
group = "timeline"
semantic = "presence"
unit = "none"
value_kind = "string"
severity = "info"

# 05-11-PLAN.md (TIME-11), the SAME `run_timeline_timecode` call as
# `timeline.timecode` immediately above -- this id is the SMPTE START
# VALUE itself, split per src/compare/presence.cpp's own documented "a
# value comparison is a separate check on the same extraction" rule
# (mirrors video.hdr.mdcv/.luminance's own split, 04-CHECK-ROSTER.md
# precedent). `exact` semantic: the value libav publishes compared BYTE
# FOR BYTE -- never parsed into fields, never normalised, trimmed or
# case-folded, so the drop-frame punctuation (a semicolon before the frame
# field, confirmed reachable on the no-decode path, 05-RESEARCH.md/
# 05-11-SUMMARY.md's own empirical resolution of Open Question 1) is part
# of the compared value: a drop-frame and non-drop-frame timecode at the
# same nominal position compare as DIFFERENT. `Absent{}` (never an empty
# string) when no tmcd track exists -- `compare/exact.cpp`'s structural
# Value::operator== makes an Absent-versus-string pair a genuine
# difference, so a timecode that disappears is caught by THIS id too, not
# only by the presence id above. Same skip-reason behaviour and the same
# `unreachable_sources` evidence as `timeline.timecode`, since both ids
# skip together from the same call.
[[check]]
id = "timeline.timecode.value"
group = "timeline"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "info"

# 06-01-PLAN.md (Phase 6's tracer, AUDIO-08/AUDIO-10, TRUST-01/TRUST-02):
# content.audio.sample_hash -- the untrimmed-output, fixed-block XXH3-128
# hash chain over every audio stream's decoded PCM (D-01/D-02/D-04), the
# first real populator of src/compare/hash.cpp's kPreconditionKeys table.
# `hash` semantic, `hash_chain` value_kind. Approved at 06-CHECK-ROSTER.md
# (approve-as-proposed): `hw_encoder` demotes to `info` (an HW encoder's
# own re-encode is expected to change the audio essence in ways this
# project does not yet model as tolerable), `transform` demotes to
# `ignore` (a declared transcode profile's own explicit expectation
# already covers intentional audio changes elsewhere).
[[check]]
id = "content.audio.sample_hash"
group = "content"
semantic = "hash"
unit = "none"
value_kind = "hash_chain"
severity = "fail"

[check.profile_severity]
hw_encoder = "info"
transform = "ignore"

# 06-03-PLAN.md (AUDIO-01, AUDIO-02), src/analyzers/audio/stream_params.cpp
# -- the six per-audio-stream identity checks: codec, sample rate, sample
# format, bit depth, channel count and canonical layout. Approved at
# 06-CHECK-ROSTER.md (the frozen Phase-6 audio/meta id roster). All six are
# codec-scoped (ContainerFamily::other): every one extracts directly from
# AVStream.codecpar after the header pass alone -- no decode pass is
# required for any of the six, so they report real values under
# `--no-content` (AUDIO-01). Unlike video.codec/profile/level/resolution
# above, a file with NO audio stream at all still emits all six of these as
# `skipped:insufficient_data` rather than nothing -- `skipped != pass` is
# load-bearing (06-CONTEXT.md's own must_have).

# codecpar->codec_id -> avcodec_get_name, the SAME field/extraction
# video.codec reads for a video stream.
[[check]]
id = "audio.codec"
group = "audio"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# The CORE rate as the compared value, with BOTH a core and an effective
# rate key in evidence (equal here) -- 06-04's HE-AAC implicit-SBR
# detection is what makes the two diverge, without changing this check's
# own value shape (06-CONTEXT.md).
[[check]]
id = "audio.sample_rate"
group = "audio"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "fail"

# codecpar->format (AVSampleFormat) -> av_get_sample_fmt_name of its
# PACKED-equivalent spelling (D-02, 06-CONTEXT.md) -- `fltp` and `flt`
# record identically, so a planar/packed difference alone is never
# reported as a format change.
[[check]]
id = "audio.sample_fmt"
group = "audio"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"

# codecpar->bits_per_raw_sample verbatim, or `Absent{}` plus an explicit
# `insufficient_data` skip when the codec declares none -- NEVER coerced to
# the sample format's container width (this plan's own prohibition: a
# fabricated number is the P0 class this project exists to prevent).
[[check]]
id = "audio.bit_depth"
group = "audio"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "fail"

# codecpar->ch_layout.nb_channels -- the count alone, never the layout
# (audio.layout below never reads this field to derive its own string).
[[check]]
id = "audio.channels"
group = "audio"
semantic = "exact"
unit = "count"
value_kind = "int64"
severity = "fail"

# 06-03-PLAN.md Task 2 (AUDIO-02), src/analyzers/audio/stream_params.cpp --
# av_channel_layout_describe on the stream's own modern channel-layout
# struct only (the legacy integer channel-mask field and its named bitmask
# constants are absent from the linked headers this build compiles
# against). An unspecified layout records its own canonical spelling ("N
# channels") as a REAL, comparable value -- never Absent{} and never a
# skip -- so a candidate that LOSES its layout reports a regression rather
# than matching a wildcard (D-14 of 06-CONTEXT.md, applied here to layout;
# mirrors src/analyzers/video/color.cpp's established treatment of
# `unspecified` as a value). This is what makes `5.1` and `5.1(side)`
# compare as DIFFERENT values on an equal channel count (AUDIO-02's
# headline war story).
[[check]]
id = "audio.layout"
group = "audio"
semantic = "exact"
unit = "none"
value_kind = "string"
severity = "fail"
