# CMake build output (per-preset binary dirs)
/build/

# vcpkg local caches/buildtrees produced by `cmake --preset` inside the
# submodule (the submodule itself is pinned/tracked; its runtime output isn't)
/vcpkg/buildtrees/
/vcpkg/downloads/
/vcpkg/packages/
/vcpkg/installed/

# CMAKE_EXPORT_COMPILE_COMMANDS database, wherever a tool copies/symlinks it
# to the repo root (the per-preset copy under /build/ is already covered above)
/compile_commands.json

# Generated test fixtures (BUILD-08): the generator manifest is provenance and
# stays tracked; the media it describes is never committed.
tests/fixtures/*
!tests/fixtures/GENERATOR_MANIFEST.json

# Hand-authored snapshot fixtures (D-10, 02-01-PLAN.md) are text, not media —
# they ARE the primary compare-engine integration harness and must be
# git-diffable, so they are tracked despite the tests/fixtures/* ignore above.
!tests/fixtures/snapshots/
!tests/fixtures/snapshots/**

# Hand-authored registry-generator fixtures (02-02-PLAN.md Task 3) are also
# text, not media — known-good/known-bad checks.def + docs/ trees proving
# the ENG-01/DOC-01 documentation gate can actually fail, tracked for the
# same reason snapshots/ is above.
!tests/fixtures/registry/
!tests/fixtures/registry/**

# Hand-authored mediadiff.toml fixtures (02-06-PLAN.md Task 1) are also
# text, not media — known-good/known-bad configs proving the ENG-11 shape
# validator can actually fail, tracked for the same reason snapshots/ is
# above.
!tests/fixtures/config/
!tests/fixtures/config/**

# Hand-authored probe-layer fixtures (03-02-PLAN.md Task 1) are also text,
# not media — a deliberately-not-a-media-file fixture proving
# DemuxSession::open's ErrorKind::input_unsupported path, tracked for the
# same reason snapshots/ is above.
!tests/fixtures/probe/
!tests/fixtures/probe/**

# GSD runtime sentinels (dispatch isolation state) — machine-local, never committed
/.gsd/

# Extracted pinned ffmpeg build (D-GAP-01, scripts/install_pinned_ffmpeg.sh):
# a downloaded, checksum-verified binary, never committed — the pin itself
# (URL + SHA-256) lives in the tracked scripts/ffmpeg_pin.json.
/.ffmpeg-pinned/
